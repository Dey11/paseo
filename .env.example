# HanabiCode runtime defaults. Copy only the values you need into a private service
# environment; do not commit a real .env file.
#
# The PASEO_* prefix is an inherited configuration/protocol API retained for
# compatibility. These values belong to HanabiCode when used with this repository.

PASEO_HOME=~/.hanabicode
PASEO_LISTEN=127.0.0.1:6769

# Relay is opt-in. The local endpoint below assumes a relay process on the same
# host. Replace the public hostname before enabling relay pairing.
PASEO_RELAY_ENABLED=false
PASEO_RELAY_ENDPOINT=127.0.0.1:4000
PASEO_RELAY_PUBLIC_ENDPOINT=relay.example.com:443
PASEO_RELAY_USE_TLS=false
PASEO_RELAY_PUBLIC_USE_TLS=true

# Pairing QR/link base. The HanabiCode app registers this scheme on Android, macOS,
# and Windows. A fork-owned HTTPS web client can replace it later.
PASEO_APP_BASE_URL=hanabicode://pair

# Optional direct-connection password. Use a secret manager or protected
# service environment in production; never commit the real value.
PASEO_PASSWORD=replace-with-a-long-random-secret

# Release builds set this automatically to the source commit. Local builds may
# leave it unset; it is public metadata, not a credential.
EXPO_PUBLIC_HANABICODE_SOURCE_COMMIT=
