# Example child image that adds agent CLIs to the HanabiCode image.
#
# Build:
#   docker build -f docker/Dockerfile.agents.example -t hanabicode-with-agents .
#
# Then set `image: hanabicode-with-agents` in docker/docker-compose.example.yml.

FROM ghcr.io/dey11/hanabicode:latest

USER root
RUN npm install -g \
  @anthropic-ai/claude-code \
  @openai/codex \
  opencode-ai

# Leave the image user as root. The base entrypoint prepares mounted volumes,
# then drops the daemon and launched agents to the non-root `hanabicode` user.
